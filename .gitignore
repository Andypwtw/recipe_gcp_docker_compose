# Secrets / local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.python-version

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime data is stored in Docker named volumes.
# These legacy local data folders are ignored if created manually.
mysql/data/
mongodb/data/
postgres/data/
kafka/data/
airflow/logs/
airflow/plugins/

# Generic logs / temp / backup
logs/
*.log
*.tmp
*.orig
*.bak
backup/*.sql
*.dump

# Price pipeline runtime outputs.  These files are regenerated by Airflow and
# must stay local to the runtime environment, otherwise git updates can create
# merge conflicts with newly fetched MOA prices.
python/Price/0[1-6]_moa_*.json
python/Price/07_moa_avgprice_per_100g.json
python/Price/08_match_nutrition_foods__moa_prices.json
