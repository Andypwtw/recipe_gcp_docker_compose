from __future__ import annotations

from app.db import get_connection


DROP_COLUMNS = [
    ("nutrition_source", "protein_g"),
    ("nutrition_source", "fat_g"),
    ("nutrition_source", "carbohydrate_g"),
    ("nutrition_source", "sodium_mg"),
    ("recipe_nutrition_summary", "protein_g"),
    ("recipe_nutrition_summary", "fat_g"),
    ("recipe_nutrition_summary", "carbohydrate_g"),
    ("recipe_nutrition_summary", "sodium_mg"),
]


def column_exists(cur, table_name: str, column_name: str) -> bool:
    cur.execute(
        """
        SELECT COUNT(*) AS cnt
        FROM information_schema.columns
        WHERE table_schema = DATABASE()
          AND table_name = %s
          AND column_name = %s
        """,
        (table_name, column_name),
    )
    return cur.fetchone()["cnt"] > 0


def main():
    with get_connection() as conn, conn.cursor() as cur:
        for table_name, column_name in DROP_COLUMNS:
            if column_exists(
                cur,
                table_name,
                column_name,
            ):
                print(
                    f"Dropping {table_name}.{column_name}"
                )
                cur.execute(
                    f"ALTER TABLE `{table_name}` "
                    f"DROP COLUMN `{column_name}`"
                )

        conn.commit()

    print("Calories-only database migration completed.")


if __name__ == "__main__":
    main()
