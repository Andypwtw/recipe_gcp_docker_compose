FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=Asia/Taipei

WORKDIR /app
COPY requirements-wanjia.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY wanjia_crawler.py /app/wanjia_crawler.py

ENTRYPOINT ["python", "/app/wanjia_crawler.py"]
