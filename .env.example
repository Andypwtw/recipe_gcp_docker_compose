# ============================================================
# Recipe Collections V11
# Copy to .env and replace all production secrets before use.
# ============================================================

TZ=Asia/Taipei

# -------------------------
# Airflow / PostgreSQL
# -------------------------
AIRFLOW_UID=50000
AIRFLOW_BIND_HOST=0.0.0.0
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_AIRFLOW_ADMIN
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_WITH_FERNET
AIRFLOW_WEBSERVER_SECRET_KEY=CHANGE_ME_RANDOM_SECRET

POSTGRES_USER=airflow
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
POSTGRES_DB=airflow

# -------------------------
# MySQL application DB
# -------------------------
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT
MYSQL_DATABASE=recipe_ai
MYSQL_USER=recipe_app
MYSQL_PASSWORD=CHANGE_ME_MYSQL_APP
MYSQL_PORT=3307

# -------------------------
# MongoDB application DB
# -------------------------
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT
MONGO_DATABASE=recipe_ai
MONGO_COLLECTION=raw_recipes
MONGO_APP_USER=recipe_app
MONGO_APP_PASSWORD=CHANGE_ME_MONGO_APP
MONGO_PORT=27018

# -------------------------
# Kafka
# -------------------------
KAFKA_PORT=9094
KAFKA_JOB_TOPIC=crawler_jobs
KAFKA_RESULT_TOPIC=ytower_recipe_results
KAFKA_JOB_PARTITIONS=5
KAFKA_RESULT_PARTITIONS=4

# -------------------------
# Flask API / Hermes
# -------------------------
FLASK_BIND_HOST=0.0.0.0
FLASK_PORT=5001
# If set, /api/v1/hermes/recommend requires this key via X-API-Key or Bearer token.
# Leave blank only for trusted local development.
HERMES_API_KEY=

# -------------------------
# YTower crawler
# -------------------------
# Airflow checks once per day; MongoDB checkpoint decides whether 7 days have elapsed.
# This gives a true "7 days after last successful checkpoint" policy.
YTOWER_DAG_SCHEDULE=@daily
YTOWER_UPDATE_INTERVAL_DAYS=7
YTOWER_CHECKPOINT_OVERLAP_DAYS=1
YTOWER_SEARCH_MAX_PAGES=100
YTOWER_SEARCH_URL=https://www.ytower.com.tw/recipe/recipe-search.asp
YTOWER_SEARCH_PAGE_PARAM=page
YTOWER_SEARCH_CHUNK_SIZE=50
YTOWER_SEARCH_OLD_PAGE_STOP=2
MAX_SEQ_NUMBER=5000
MAX_NOT_FOUND_LIMIT=50
REQUEST_TIMEOUT=20
REQUEST_RETRIES=3
# One prefix may take many hours. 16h avoids premature consumer-group rebalance.
MAX_POLL_INTERVAL_MS=57600000
COOLDOWN_SUCCESS_COUNT=50
CRAWL_SLEEP_MIN=2.5
CRAWL_SLEEP_MAX=5.0
DIRECT_CRAWL_SLEEP_MIN=4.0
DIRECT_CRAWL_SLEEP_MAX=8.0
DIRECT_BLOCK_COOLDOWN_SECONDS=900
DIRECT_BLOCK_MAX_RETRIES=2
NOT_FOUND_SLEEP_MIN=0.5
NOT_FOUND_SLEEP_MAX=1.2
COOLDOWN_SLEEP_MIN=10
COOLDOWN_SLEEP_MAX=20

# -------------------------
# Dynamic Taiwan proxy pool
# -------------------------
PROXY_COUNTRY_CODE=TW
PROXY_DISCOVERY_INTERVAL=1800
PROXY_VALIDATION_TIMEOUT=15
PROXY_VALIDATION_WORKERS=20
PROXY_MAX_VALIDATE_PER_CYCLE=200
PROXY_MAX_LATENCY_MS=10000
PROXY_TCP_TIMEOUT=3
PROXY_MAX_FAILURES=3
PROXY_LEASE_SECONDS=1800
PROXY_WAIT_SECONDS=15
MAX_PROXY_SWITCHES_PER_SEQ=5
PROXY_STALE_HOURS=12
# Optional commercial provider endpoints. Keep credentials only in .env (never commit .env).
# Paste provider-generated URLs as comma-separated proxy URLs when you have a plan.
LUMIPROXY_PROXY_URLS=
CROXY_PROXY_URLS=

# -------------------------
# Mongo writer
# -------------------------
MONGO_BATCH_SIZE=50
